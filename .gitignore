# CloudWatch Omni IDE 拡張のローカル設定（トークンを含む）
.omni/
.env.omni

# エディタ・エージェント設定
.claude/
.cursor/
.kiro/
.agents/

# CloudWatch Omni の VS Code 拡張は、フォルダを開くたびに .github/ の行が無ければ末尾に足す。
# 先に .github/ を書いて書き足しを止め、直後の行で打ち消して .github/ を git に残す
.github/
!.github/

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/

# CDK / Node
infra/node_modules/
infra/cdk.out/
infra/**/*.js
infra/**/*.d.ts
!infra/jest.config.js

# 評価結果
eval/results/

.DS_Store
